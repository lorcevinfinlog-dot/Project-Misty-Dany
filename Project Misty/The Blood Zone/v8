local function isCapturing(type, id)
    if not capturingBindingFor then return false end
    if capturingBindingFor.type ~= type then return false end
    if type == "player" then return capturingBindingFor.userId == id end
    if type == "waypoint" then return capturingBindingFor.index == id end
    return false
end

local refreshWaypoints -- forward declaration (используется в обработчике ввода)

local function refreshPlayerList()
    for _, ch in ipairs(PagePlayers:GetChildren()) do
        if ch:IsA("Frame") or ch:IsA("TextLabel") then ch:Destroy() end
    end

    local header = Instance.new("TextLabel", PagePlayers)
    header.Size = UDim2.new(1, 0, 0, 18)
    header.BackgroundTransparency = 1
    header.Font = Enum.Font.GothamBold
    header.TextSize = 10
    header.TextColor3 = Palette.TEXT_MUTED
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Text = "ИГРОКИ  •  клик = TP  |  + = бинд"

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local row = Instance.new("Frame", PagePlayers)
            row.Name = p.Name
            row.Size = UDim2.new(1, 0, 0, 30)
            row.BackgroundColor3 = Palette.BG_ROW
            row.BorderSizePixel = 0
            applyCorner(row, 6)

            local btn = Instance.new("TextButton", row)
            btn.BackgroundColor3 = Palette.BG_BUTTON
            btn.BorderSizePixel = 0
            btn.Size = UDim2.new(1, -36, 1, -4)
            btn.Position = UDim2.new(0, 2, 0, 2)
            btn.Font = Enum.Font.Gotham
            btn.TextSize = 11
            btn.TextColor3 = Palette.TEXT
            btn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
            btn.TextTruncate = Enum.TextTruncate.AtEnd
            btn.AutoButtonColor = false
            applyCorner(btn, 5)

            local bindBtn = Instance.new("TextButton", row)
            bindBtn.BackgroundColor3 = Palette.BG_BUTTON
            bindBtn.BorderSizePixel = 0
            bindBtn.Size = UDim2.new(0, 30, 1, -4)
            bindBtn.Position = UDim2.new(1, -33, 0, 2)
            bindBtn.Font = Enum.Font.GothamBold
            bindBtn.TextSize = 10
            bindBtn.TextColor3 = Palette.TEXT_DIM
            bindBtn.AutoButtonColor = false
            applyCorner(bindBtn, 5)

            local savedKey = keybinds[p.UserId]
            if isCapturing("player", p.UserId) then
                bindBtn.Text = "..."
                bindBtn.TextColor3 = Palette.WARN
            elseif savedKey then
                bindBtn.Text = savedKey.Name
                bindBtn.TextColor3 = Palette.SUCCESS
            else
                bindBtn.Text = "+"
            end

            btn.MouseButton1Click:Connect(function()
                if capturingBindingFor then return end
                btn.Text = "Teleport... " .. p.Name
                btn.TextColor3 = Palette.WARN
                task.spawn(function()
                    local ok = teleportToPlayer(p)
                    btn.Text = (ok and "✔ " or "✖ ") .. p.DisplayName
                    btn.TextColor3 = ok and Palette.SUCCESS or Palette.DANGER
                    task.wait(1.0)
                    if btn.Parent then
                        btn.Text = p.DisplayName .. " (@" .. p.Name .. ")"
                        btn.TextColor3 = Palette.TEXT
                    end
                end)
            end)

            bindBtn.MouseButton1Click:Connect(function()
                if isCapturing("player", p.UserId) then
                    capturingBindingFor = nil
                else
                    capturingBindingFor = { type = "player", userId = p.UserId }
                end
                refreshPlayerList()
            end)
        end
    end
end

