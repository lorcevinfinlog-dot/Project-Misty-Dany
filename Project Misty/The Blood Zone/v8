local function GetTargetPart(char)
    if not char then return nil end
    if Settings.TargetPart == "Head" then
        return char:FindFirstChild("Head")
    else
        return char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end
end

local function IsBulletPathClear(targetPart)
    if not targetPart then return false end
    local origin = Camera.CFrame.Position
    local ignoreList = {LocalPlayer.Character, targetPart.Parent}
    for _ = 1, 5 do
        local rp = RaycastParams.new()
        rp.FilterType = Enum.RaycastFilterType.Exclude
        rp.FilterDescendantsInstances = ignoreList
        local result = Workspace:Raycast(origin, targetPart.Position - origin, rp)
        if not result then return true end
        local hit = result.Instance
        if hit.Transparency > 0.25 or hit.Material == Enum.Material.Glass
           or hit.Name:lower():find("glass") or hit.Name:lower():find("window") then
            table.insert(ignoreList, hit)
        else
            return false
        end
    end
    return false
end

local function GetClosestTargetInFOV()
    local closest = nil
    local shortestDist = Settings.FOVRadius
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and not Settings.Friends[player.UserId]
           and player.Character and player.Character:FindFirstChild("Humanoid")
           and player.Character.Humanoid.Health > 0 then
            local tp = GetTargetPart(player.Character)
            if tp then
                local sp, onScreen = Camera:WorldToViewportPoint(tp.Position)
                if onScreen then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d <= shortestDist and IsBulletPathClear(tp) then
                        shortestDist = d
                        closest = player
                    end
                end
            end
        end
    end
    return closest
end

