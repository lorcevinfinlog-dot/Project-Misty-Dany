local tabs = {}
local currentTab = nil

local function switchTab(name)
    for _, t in ipairs(tabs) do
        t.page.Visible = (t.name == name)
        if t.name == name then
            t.btn.BackgroundColor3 = Palette.ACCENT
            t.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            t.stroke.Color = Palette.ACCENT_BRIGHT
            t.stroke.Transparency = 0.1
        else
            t.btn.BackgroundColor3 = Palette.BG_TAB
            t.btn.TextColor3 = Palette.TEXT_DIM
            t.stroke.Color = Palette.ACCENT_DEEP
            t.stroke.Transparency = 0.6
        end
    end
    currentTab = name
end

local function createTab(name, label, page)
    local btn = Instance.new("TextButton", Sidebar)
    btn.Size = UDim2.new(1, 0, 0, 32)
    btn.BackgroundColor3 = Palette.BG_TAB
    btn.BorderSizePixel = 0
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 11
    btn.Text = label
    btn.TextColor3 = Palette.TEXT_DIM
    btn.AutoButtonColor = false
    applyCorner(btn, 7)
    local stroke = applyStroke(btn, Palette.ACCENT_DEEP, 1, 0.6)

    btn.MouseButton1Click:Connect(function() switchTab(name) end)
    btn.MouseEnter:Connect(function()
        if currentTab ~= name then btn.BackgroundColor3 = Palette.BG_BUTTON_HOV end
    end)
    btn.MouseLeave:Connect(function()
        if currentTab ~= name then btn.BackgroundColor3 = Palette.BG_TAB end
    end)
    table.insert(tabs, { name = name, btn = btn, page = page, stroke = stroke })
end

