local CONFIG_FILE = "MistyJump_config.json"
local canSave = (typeof(writefile) == "function" and typeof(readfile) == "function")

local Config = {
    waypoints = {},
    playerBinds = {},
    guiPositions = {},
}

local function loadConfig()
    if not canSave then return end
    if typeof(isfile) == "function" and isfile(CONFIG_FILE) then
        local ok, data = pcall(function()
            return HttpService:JSONDecode(readfile(CONFIG_FILE))
        end)
        if ok and type(data) == "table" then
            Config.waypoints    = data.waypoints    or {}
            Config.playerBinds  = data.playerBinds  or {}
            Config.guiPositions = data.guiPositions or {}
        end
    end
end

local function saveConfig()
    if not canSave then return end
    pcall(function()
        writefile(CONFIG_FILE, HttpService:JSONEncode(Config))
    end)
end

local function udim2ToTable(ud)
    return { xs = ud.X.Scale, xo = ud.X.Offset, ys = ud.Y.Scale, yo = ud.Y.Offset }
end
local function tableToUdim2(t)
    if not t then return nil end
    return UDim2.new(t.xs or 0, t.xo or 0, t.ys or 0, t.yo or 0)
end
local function SaveGuiPosition(key, frame)
    if not key or not frame then return end
    Config.guiPositions[key] = udim2ToTable(frame.Position)
    saveConfig()
end
local function LoadGuiPosition(key, frame)
    if not key or not frame then return end
    local t = Config.guiPositions[key]
    if t then
        local pos = tableToUdim2(t)
        if pos then frame.Position = pos end
    end
end

