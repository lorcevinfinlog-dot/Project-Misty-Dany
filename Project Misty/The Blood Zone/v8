local function pinCharacter(char, root, cf)
    pcall(function() char:PivotTo(cf) end)
    root.CFrame = cf
    root.Velocity = Vector3.zero
    root.AssemblyLinearVelocity = Vector3.zero
    root.RotVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
end

local function holdPosition(getTargetCFrame, seconds, threshold)
    seconds = seconds or TP_HOLD_TIME
    threshold = threshold or getThreshold()
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root then return false end
    if hum then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)
    end
    local deadline = tick() + seconds
    local ok = true
    while tick() < deadline do
        local target = getTargetCFrame()
        if not target then ok = false break end
        pinCharacter(char, root, target)
        if (root.Position - target.Position).Magnitude > threshold * 3 then ok = false break end
        RunService.Heartbeat:Wait()
    end
    if hum then
        pcall(function()
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
        end)
    end
    return ok
end

local function teleportAndVerify(getTargetCFrame, holdTime, threshold, maxAttempts)
    holdTime = holdTime or TP_HOLD_TIME
    threshold = threshold or getThreshold()
    maxAttempts = maxAttempts or TP_MAX_ATTEMPTS
    local char = LocalPlayer.Character
    if not char then return false end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false end
    for _ = 1, maxAttempts do
        local cf = getTargetCFrame()
        if not cf then return false end
        pinCharacter(char, root, cf)
        local ok = holdPosition(getTargetCFrame, holdTime, threshold)
        task.wait(0.03)
        local ft = getTargetCFrame()
        if ft then
            if (root.Position - ft.Position).Magnitude <= threshold then
                fixUnderground(); return true
            end
        elseif ok then
            fixUnderground(); return true
        end
    end
    return false
end

local function teleportToPlayer(targetPlayer)
    if targetPlayer == LocalPlayer then return false end
    if not targetPlayer.Character then return false end
    return teleportAndVerify(function()
        local tChar = targetPlayer.Character
        if not tChar then return nil end
        local tRoot = tChar:FindFirstChild("HumanoidRootPart")
        if not tRoot then return nil end
        local safeCF = findSafeSpotNear(tRoot.Position, TP_DISTANCE, LocalPlayer.Character)
        if safeCF then return safeCF end
        return tRoot.CFrame
    end, TP_HOLD_TIME, getThreshold(), TP_MAX_ATTEMPTS)
end

local function teleportToDeath()
    if not deathReady or not deathPosition then return false end
    local saved = deathPosition
    return teleportAndVerify(function()
        local g = findGroundAtXZ(saved.X, saved.Z, saved.Y + 200, LocalPlayer.Character)
        if g then return CFrame.new(g) end
        return CFrame.new(saved)
    end, TP_HOLD_TIME, 6, TP_MAX_ATTEMPTS)
end

local function teleportToWaypoint(wp)
    return teleportAndVerify(function()
        local pos = Vector3.new(wp.x, wp.y, wp.z)
        local g = findGroundAtXZ(pos.X, pos.Z, pos.Y + 200, LocalPlayer.Character)
        if g then return CFrame.new(g) end
        return CFrame.new(pos)
    end, TP_HOLD_TIME, getThreshold(), TP_MAX_ATTEMPTS)
end

