--==============================================================
--  INPUT
--==============================================================
local InputConn
InputConn = UserInputService.InputBegan:Connect(function(input, gpe)
    -- 1) Ожидание бинда
    if WaitingBind then
        local validMouse = input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.MouseButton2
            or input.UserInputType == Enum.UserInputType.MouseButton3
        local newBind
        if input.UserInputType == Enum.UserInputType.Keyboard then
            newBind = input.KeyCode
        elseif validMouse then
            newBind = input.UserInputType
        else
            return
        end
        WaitingBind.Set(newBind)
        local lbl = WaitingBind.Button:FindFirstChildOfClass("TextLabel")
        if lbl then lbl.Text = WaitingBind.Label .. ": " .. GetBindName(newBind) end
        WaitingBind.Button.BackgroundColor3 = Palette.BG_BUTTON
        WaitingBind = nil
        return
    end

    -- 2) Захват бинда
    if capturingBindingFor then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local keyName = (input.KeyCode == Enum.KeyCode.Escape) and nil or input.KeyCode.Name
            if capturingBindingFor.type == "player" then
                local uid = capturingBindingFor.userId
                if keyName then
                    keybinds[uid] = input.KeyCode
                    Config.playerBinds[tostring(uid)] = keyName
                else
                    keybinds[uid] = nil
                    Config.playerBinds[tostring(uid)] = nil
                end
                saveConfig()
                capturingBindingFor = nil
                task.defer(refreshPlayerList)
            elseif capturingBindingFor.type == "waypoint" then
                local idx = capturingBindingFor.index
                if Config.waypoints[idx] then
                    Config.waypoints[idx].key = keyName
                end
                saveConfig()
                capturingBindingFor = nil
                task.defer(refreshWaypoints)
            end
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then
            capturingBindingFor = nil
            task.defer(function() refreshPlayerList(); refreshWaypoints() end)
        end
        return
    end

    if gpe then return end

    -- 3) Аимбот / автолок
    if input.KeyCode == Settings.AimbotBind or input.UserInputType == Settings.AimbotBind then
        Settings.IsAimbotHeld = true
        Settings.LockedTarget = GetClosestTargetInFOV()
        return
    end
    if input.KeyCode == Settings.AutoLockBind or input.UserInputType == Settings.AutoLockBind then
        Settings.AutoLock0 = not Settings.AutoLock0
        Settings.LockedTarget = Settings.AutoLock0 and GetClosestTargetInFOV() or nil
        return
    end

    -- 4) Insert / Delete
    if input.KeyCode == Enum.KeyCode.Insert then
        ToggleUI()
        return
    elseif input.KeyCode == Enum.KeyCode.Delete then
        ScriptUnloaded = true
        SpectateTarget = nil
        if RenderConn then RenderConn:Disconnect() end
        if ESPConn then ESPConn:Disconnect() end
        if AimConn then AimConn:Disconnect() end
        if InputConn then InputConn:Disconnect() end
        pcall(function() FOVCircle:Remove() end)
        ScreenGui:Destroy()
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character then
                if p.Character:FindFirstChild("BloodZone_ESP") then
                    p.Character.BloodZone_ESP:Destroy()
                end
                local head = p.Character:FindFirstChild("Head")
                if head and head:FindFirstChild("BloodZone_Tag") then
                    head.BloodZone_Tag:Destroy()
                end
            end
        end
        return
    end

    -- 5) Бинды игроков и WP
    if input.UserInputType == Enum.UserInputType.Keyboard and not UserInputService:GetFocusedTextBox() then
        for userId, key in pairs(keybinds) do
            if key == input.KeyCode then
                local p = Players:GetPlayerByUserId(userId)
                if p and p.Character then
                    task.spawn(function() teleportToPlayer(p) end)
                end
                break
            end
        end
        for _, wp in ipairs(Config.waypoints) do
            if wp.key then
                local kc = Enum.KeyCode[wp.key]
                if kc and kc == input.KeyCode then
                    task.spawn(function() teleportToWaypoint(wp) end)
                    break
                end
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
