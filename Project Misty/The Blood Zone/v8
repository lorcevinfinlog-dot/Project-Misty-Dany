local function pickRandomSpotNear(center, radius, char)
    for _ = 1, 20 do
        local angle = math.random() * math.pi * 2
        local dist  = radius * math.sqrt(math.random())
        local x = center.X + math.cos(angle) * dist
        local z = center.Z + math.sin(angle) * dist
        local g = findGroundAtXZ(x, z, center.Y + 50, char)
        if g and not isStuckAt(g, char) then
            return CFrame.new(g)
        end
    end
    return nil
end

