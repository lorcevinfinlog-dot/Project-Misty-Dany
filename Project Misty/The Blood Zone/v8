local function CreateToggle(text, state, callback, parent)
    local Btn = Instance.new("TextButton", parent)
    Btn.Size = UDim2.new(1, 0, 0, 36)
    Btn.BackgroundColor3 = state and Palette.ON or Palette.OFF
    Btn.Text = ""
    Btn.AutoButtonColor = false
    applyCorner(Btn, 8)

    local st = applyStroke(Btn, state and Palette.ACCENT_BRIGHT or Palette.ACCENT_DEEP, 1.2, 0.3)
    local gr = applyGradient(Btn,
        state and Color3.fromRGB(60, 140, 255) or Color3.fromRGB(30, 44, 70),
        state and Color3.fromRGB(30, 90, 200) or Color3.fromRGB(18, 28, 48), 90)

    local Ind = Instance.new("Frame", Btn)
    Ind.Size = UDim2.new(0, 4, 1, -14)
    Ind.Position = UDim2.new(0, 7, 0, 7)
    Ind.BackgroundColor3 = state and Palette.ACCENT_BRIGHT or Palette.TEXT_MUTED
    Ind.BorderSizePixel = 0
    applyCorner(Ind, 2)

    local lbl = Instance.new("TextLabel", Btn)
    lbl.BackgroundTransparency = 1
    lbl.Size = UDim2.new(1, -90, 1, 0)
    lbl.Position = UDim2.new(0, 22, 0, 0)
    lbl.Font = Enum.Font.GothamBold
    lbl.TextSize = 12
    lbl.TextColor3 = state and Palette.TEXT or Palette.TEXT_DIM
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Text = text

    local StL = Instance.new("TextLabel", Btn)
    StL.BackgroundTransparency = 1
    StL.Position = UDim2.new(1, -74, 0, 0)
    StL.Size = UDim2.new(0, 66, 1, 0)
    StL.Font = Enum.Font.GothamBold
    StL.TextSize = 11
    StL.TextColor3 = state and Palette.TEXT or Palette.TEXT_MUTED
    StL.TextXAlignment = Enum.TextXAlignment.Right
    StL.Text = state and "ON" or "OFF"

    Btn.MouseEnter:Connect(function() if not state then Btn.BackgroundColor3 = Palette.BG_BUTTON_HOV end end)
    Btn.MouseLeave:Connect(function() if not state then Btn.BackgroundColor3 = Palette.OFF end end)

    Btn.MouseButton1Click:Connect(function()
        state = not state
        Btn.BackgroundColor3 = state and Palette.ON or Palette.OFF
        st.Color = state and Palette.ACCENT_BRIGHT or Palette.ACCENT_DEEP
        gr.Color = ColorSequence.new(
            state and Color3.fromRGB(60, 140, 255) or Color3.fromRGB(30, 44, 70),
            state and Color3.fromRGB(30, 90, 200) or Color3.fromRGB(18, 28, 48))
        Ind.BackgroundColor3 = state and Palette.ACCENT_BRIGHT or Palette.TEXT_MUTED
        lbl.TextColor3 = state and Palette.TEXT or Palette.TEXT_DIM
        StL.TextColor3 = state and Palette.TEXT or Palette.TEXT_MUTED
        StL.Text = state and "ON" or "OFF"
        if callback then callback(state) end
    end)
    return Btn
end

local function CreateSlider(labelText, minVal, maxVal, initial, parent, onChange)
    local frame = Instance.new("Frame", parent)
    frame.Size = UDim2.new(1, 0, 0, 54)
    frame.BackgroundColor3 = Palette.BG_BUTTON
    frame.BorderSizePixel = 0
    applyCorner(frame, 8)
    applyStroke(frame, Palette.ACCENT, 1.2, 0.3)
    applyGradient(frame, Color3.fromRGB(28, 42, 72), Palette.BG_BUTTON, 90)

    local label = Instance.new("TextLabel", frame)
    label.Size = UDim2.new(1, -22, 0, 22)
    label.Position = UDim2.new(0, 16, 0, 4)
    label.BackgroundTransparency = 1
    label.Text = labelText .. ": " .. initial
    label.TextColor3 = Palette.TEXT
    label.Font = Enum.Font.GothamBold
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left

    local back = Instance.new("Frame", frame)
    back.Size = UDim2.new(1, -32, 0, 8)
    back.Position = UDim2.new(0, 16, 0, 36)
    back.BackgroundColor3 = Color3.fromRGB(12, 20, 36)
    back.BorderSizePixel = 0
    applyCorner(back, 4)
    applyStroke(back, Palette.ACCENT_DEEP, 1, 0.5)

    local startPos = math.clamp((initial - minVal) / (maxVal - minVal), 0, 1)

    local fill = Instance.new("Frame", back)
    fill.Size = UDim2.new(startPos, 0, 1, 0)
    fill.BackgroundColor3 = Palette.ACCENT_BRIGHT
    fill.BorderSizePixel = 0
    applyCorner(fill, 4)
    applyGradient(fill, Palette.ACCENT_BRIGHT, Palette.ACCENT, 0)

    local knob = Instance.new("Frame", back)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = UDim2.new(startPos, -7, 0.5, -7)
    knob.BackgroundColor3 = Palette.TEXT
    knob.BorderSizePixel = 0
    applyCorner(knob, 7)
    applyStroke(knob, Palette.ACCENT_BRIGHT, 2, 0)

    local sliding = false
    local function update(input)
        local pos = math.clamp((input.Position.X - back.AbsolutePosition.X) / back.AbsoluteSize.X, 0, 1)
        local val = math.floor(minVal + (maxVal - minVal) * pos)
        fill.Size = UDim2.new(pos, 0, 1, 0)
        knob.Position = UDim2.new(pos, -7, 0.5, -7)
        label.Text = labelText .. ": " .. val
        if onChange then onChange(val) end
    end
    back.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            sliding = true; update(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then sliding = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if sliding and input.UserInputType == Enum.UserInputType.MouseMovement then update(input) end
    end)
    return frame
end

