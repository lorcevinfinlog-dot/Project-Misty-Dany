local function makeRayParams(char)
    local p = RaycastParams.new()
    if char then p.FilterDescendantsInstances = {char} end
    p.FilterType = Enum.RaycastFilterType.Exclude
    return p
end

local function isStuckAt(pos, char)
    local rp = makeRayParams(char)
    local dirs = {
        Vector3.new(2, 0, 0), Vector3.new(-2, 0, 0),
        Vector3.new(0, 2, 0), Vector3.new(0, -2, 0),
        Vector3.new(0, 0, 2), Vector3.new(0, 0, -2),
    }
    local hits = 0
    for _, d in ipairs(dirs) do
        if Workspace:Raycast(pos, d, rp) then hits = hits + 1 end
    end
    return hits >= 5
end

local function findGroundAtXZ(x, z, fromY, char)
    local rp = makeRayParams(char)
    local hit = Workspace:Raycast(Vector3.new(x, fromY, z), Vector3.new(0, -2000, 0), rp)
    if hit then return Vector3.new(x, hit.Position.Y + 3.5, z) end
    return nil
end

local function findSafeSpotNear(targetPos, dist, char)
    if dist <= 0 then
        local g = findGroundAtXZ(targetPos.X, targetPos.Z, targetPos.Y + 200, char)
        if g then return CFrame.new(g) end
        return CFrame.new(targetPos)
    end
    local angles = {0, 22.5, 45, 67.5, 90, 112.5, 135, 157.5,
                    180, 202.5, 225, 247.5, 270, 292.5, 315, 337.5}
    local radii = { dist, dist * 0.7, dist * 1.3 }
    local fromY = targetPos.Y + 500
    for _, r in ipairs(radii) do
        for _, ang in ipairs(angles) do
            local rad = math.rad(ang)
            local x = targetPos.X + math.cos(rad) * r
            local z = targetPos.Z + math.sin(rad) * r
            local gp = findGroundAtXZ(x, z, fromY, char)
            if gp and not isStuckAt(gp, char) then return CFrame.new(gp) end
        end
    end
    for _, dy in ipairs({5, 10, 20, 40}) do
        local tp = targetPos + Vector3.new(0, dy, 0)
        if not isStuckAt(tp, char) then return CFrame.new(tp) end
    end
    local g = findGroundAtXZ(targetPos.X, targetPos.Z, targetPos.Y + 200, char)
    if g then return CFrame.new(g) end
    return CFrame.new(targetPos)
end

local function isUnderMap(origin, char)
    local rp = makeRayParams(char)
    if Workspace:Raycast(origin, Vector3.new(0, -5, 0), rp) then return false end
    local sides = {
        Vector3.new(30, 0, 0), Vector3.new(-30, 0, 0),
        Vector3.new(0, 0, 30), Vector3.new(0, 0, -30),
    }
    for _, d in ipairs(sides) do
        if Workspace:Raycast(origin, d, rp) then return false end
    end
    local up = Workspace:Raycast(origin, Vector3.new(0, 1000, 0), rp)
    if not up then return false end
    if (up.Position - origin).Magnitude < 10 then return false end
    return true
end

local function findEscapeUp(origin, char)
    local y = 2
    for _ = 1, 250 do
        local tp = origin + Vector3.new(0, y, 0)
        if not isStuckAt(tp, char) then return tp end
        y = y + 2
    end
    return nil
end

local function fixUnderground()
    local char = LocalPlayer.Character
    if not char then return false, nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return false, nil end
    local origin = root.Position
    local stuck = isStuckAt(origin, char)
    local under = isUnderMap(origin, char)
    if not stuck and not under then return false, nil end
    local tp = nil
    if stuck then
        tp = findEscapeUp(origin, char)
    elseif under then
        local rp = makeRayParams(char)
        local up = Workspace:Raycast(origin, Vector3.new(0, 1000, 0), rp)
        if up then tp = Vector3.new(origin.X, up.Position.Y + 3, origin.Z) end
    end
    if not tp then tp = origin + Vector3.new(0, 20, 0) end
    local g = findGroundAtXZ(tp.X, tp.Z, tp.Y + 100, char)
    if g then tp = g end
    root.CFrame = CFrame.new(tp)
    root.Velocity = Vector3.zero
    root.AssemblyLinearVelocity = Vector3.zero
    return true, (stuck and "stuck" or "under")
end

